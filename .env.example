# Copy to .env for local development. Every variable is optional unless noted.

# Where the app is reachable from browsers, without a trailing slash.
# Required in production; used for OAuth redirect URLs and secure cookies.
# A path is allowed for running under a prefix, e.g. https://example.com/almanac
ALMANAC_PUBLIC_URL=http://localhost:5173

PORT=8787
ALMANAC_DATA_DIR=./data
ALMANAC_TIMEZONE=America/Chicago

# Who may sign in. Comma-separated emails. Admins are always allowed.
ALMANAC_ADMIN_EMAILS=
ALMANAC_ALLOWED_EMAILS=

# OpenID Connect provider. Google is the default; any OIDC provider works
# (Authentik, Authelia, Keycloak, ...). Redirect URI to register:
#   <ALMANAC_PUBLIC_URL>/auth/callback
OIDC_ISSUER=https://accounts.google.com
OIDC_PROVIDER_NAME=Google
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Local development only: show a "sign in as" picker for allowed emails
# instead of the OIDC provider. Ignored when NODE_ENV=production.
ALMANAC_DEV_LOGIN=1
