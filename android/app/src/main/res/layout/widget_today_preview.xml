<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows: the widget with a few made-up tasks. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_shape">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_title"
            android:textColor="@color/widget_on_surface"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/widget_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_preview_load"
            android:textColor="@color/widget_on_secondary_container"
            android:textSize="12sp" />

        <TextView style="@style/WidgetPreviewRow" android:text="@string/widget_preview_1" />
        <TextView style="@style/WidgetPreviewRow" android:text="@string/widget_preview_2" />
    </LinearLayout>
</FrameLayout>
