{
  "name": "almanac",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, shared, self-hosted planner that knows how full your days are.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:device": "node scripts/device.ts build",
    "dev:device": "node scripts/device.ts dev",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:wasm": "node scripts/test-wasm.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@hono/node-server": "2.1.5",
    "@material/material-color-utilities": "0.4.0",
    "@modelcontextprotocol/server": "2.3.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "openid-client": "6.8.8",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@fontsource-variable/google-sans-flex": "5.3.2",
    "@iconify-json/material-symbols": "^1.2.95",
    "@modelcontextprotocol/client": "2.3.1",
    "@resvg/resvg-js": "2.6.2",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-query-persist-client": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "motion": "14.2.0",
    "playwright-core": "^1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "temporal-polyfill": "1.0.5",
    "typescript": "7.0.2",
    "unplugin-icons": "24.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
