# Copy to .env for local development. Every variable is optional unless noted.

# The server's address, without a trailing slash: where it serves the app and its own pages.
# Required in production; used for OAuth redirect URLs and secure cookies.
# A path is allowed for running under a prefix, e.g. https://example.com/amble
# `pnpm dev` serves the app through Vite on 127.0.0.1:5174, which passes the server's routes on.
AMBLE_PUBLIC_URL=http://127.0.0.1:5174
# After moving the app to another path, the old one can send people and links on to the new one:
# AMBLE_REDIRECT_FROM=/old-path
# (Settings named ALMANAC_*, from before the app was renamed Amble, still work.)

PORT=8787
AMBLE_DATA_DIR=./data
AMBLE_TIMEZONE=America/Chicago

# Who may sign in to the server (to sync with it, or connect Claude or ChatGPT).
# Comma-separated emails. Admins are always allowed.
AMBLE_ADMIN_EMAILS=
AMBLE_ALLOWED_EMAILS=

# Who to ask about privacy, shown on the app's /privacy page (Google's consent screen asks for
# a privacy policy link). Optional.
# AMBLE_PRIVACY_CONTACT=you@example.com

# OpenID Connect provider. Google is the default; any OIDC provider works
# (Authentik, Authelia, Keycloak, ...). Redirect URI to register:
#   <AMBLE_PUBLIC_URL>/auth/callback
# docs/sign-in.md has the steps for each provider.
OIDC_ISSUER=https://accounts.google.com
OIDC_PROVIDER_NAME=Google
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Google Drive, for the server and for the app it serves. With Google sign-in above, the same
# client is used; with another provider, give a Google OAuth client of its own (web application,
# redirect URI <AMBLE_PUBLIC_URL>/auth/callback). Turn on the Google Drive API and the Google Picker
# API in its Cloud project. An admin connects the server to a household on the server's own page
# (<AMBLE_PUBLIC_URL>/server). docs/google-drive.md has the setup.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# For the file picker in the app the server serves: a key restricted to the Google Picker API and
# the server's address.
# AMBLE_GOOGLE_API_KEY=
# Apps served from other addresses (a static copy, say) that may sync with this server and use its
# /google/token, comma-separated.
# AMBLE_APP_ORIGINS=https://amble.example.com

# The app built on its own (AMBLE_BASE=/ pnpm build, for a static host), and `pnpm dev`, sign in to
# Google in the browser with these, which end up in the app's code. An app the server serves gets
# them from the server instead.
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_API_KEY=            # a key restricted to the Google Picker API and the app's address
# VITE_GOOGLE_APP_ID=             # the Cloud project number
# Where a browser renews its Drive access without asking: an Amble server's /google/token, or the
# worker in deploy/google-token-worker. Without it, the app renews by a quick trip to Google.
# VITE_GOOGLE_TOKEN_URL=

# Files are kept under <AMBLE_DATA_DIR>/files, each up to this many megabytes.
# AMBLE_MAX_FILE_MB=25

# Assistants that may connect to the connector: Claude and ChatGPT (hosts of their
# client metadata URLs and web redirect URIs). Loopback apps such as Claude Code always can.
AMBLE_OAUTH_CLIENT_HOSTS=claude.ai,claude.com,chatgpt.com

# Local development only: the sign-in page also offers "sign in as" for allowed emails, and the
# app it serves can be driven by scripts/. Ignored when NODE_ENV=production.
AMBLE_DEV_LOGIN=1

# AI: smart add, size guesses, the morning's suggestions, Plan my week and Tidy up all use one fast
# model, from any provider. Optional: without one, quick add adds things as typed and the planner
# words things itself. Phones that sync with this server and have no model of their own use this one.
# Providers: anthropic (Claude Haiku 5.5), openai (GPT-6 Luna), gemini (Gemini Flash-Lite, free tier),
# zai (GLM Flash, free), openrouter (any model, one key), or custom (any OpenAI-style API, such as
# Ollama at http://localhost:11434/v1, which needs no key).
# In Docker, put the key in secrets/ai_api_key instead (AMBLE_AI_API_KEY_FILE points at it).
# AMBLE_AI_PROVIDER=anthropic
# AMBLE_AI_API_KEY=
# AMBLE_AI_MODEL=               # empty for the provider's suggested model
# AMBLE_AI_BASE_URL=            # custom only: the API's address
# AMBLE_AI_EFFORT=              # default, low, medium or high; empty for the model's suggested one
# AMBLE_AI_MONTHLY_CAP_USD=10   # AI features pause for the rest of the month past this
# AMBLE_AI_PRICES=0.1,0.5       # dollars per million tokens in and out, for a model Amble doesn't know
# Older setups: an Anthropic key on its own still works, as ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
