{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ESNext.Temporal", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "unplugin-icons/types/react"]
  },
  "include": ["server", "shared", "web/src", "scripts", "vite.config.ts", "drizzle.config.ts", "capacitor.config.ts", "deploy/google-token-worker"]
}
