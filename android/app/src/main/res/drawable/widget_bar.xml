<?xml version="1.0" encoding="utf-8"?>
<!-- The load bar: a round track and a fill that stays round at its end (scaled, not clipped). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="4dp" />
            <solid android:color="@color/widget_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale
            android:scaleGravity="start|center_vertical"
            android:scaleWidth="100%">
            <shape>
                <corners android:radius="4dp" />
                <solid android:color="@color/widget_primary" />
            </shape>
        </scale>
    </item>
</layer-list>
