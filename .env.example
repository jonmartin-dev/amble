# Copy to .env for local development. Every variable is optional unless noted.

# Where the app is reachable from browsers, without a trailing slash.
# Required in production; used for OAuth redirect URLs and secure cookies.
# A path is allowed for running under a prefix, e.g. https://example.com/almanac
ALMANAC_PUBLIC_URL=http://localhost:5173

PORT=8787
ALMANAC_DATA_DIR=./data
ALMANAC_TIMEZONE=America/Chicago

# Who may sign in. Comma-separated emails. Admins are always allowed.
ALMANAC_ADMIN_EMAILS=
ALMANAC_ALLOWED_EMAILS=

# OpenID Connect provider. Google is the default; any OIDC provider works
# (Authentik, Authelia, Keycloak, ...). Redirect URI to register:
#   <ALMANAC_PUBLIC_URL>/auth/callback
OIDC_ISSUER=https://accounts.google.com
OIDC_PROVIDER_NAME=Google
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Google Calendar, so busy days have less room for tasks. With Google sign-in above, the same
# client is used and nothing needs setting here; just enable the Google Calendar API in its Cloud
# project. With another sign-in provider, give a Google OAuth client of its own (web application,
# redirect URI <ALMANAC_PUBLIC_URL>/auth/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apps that may connect to the Claude connector (hosts of their client metadata
# URLs and web redirect URIs). Loopback apps such as Claude Code always can.
ALMANAC_OAUTH_CLIENT_HOSTS=claude.ai,claude.com

# Local development only: show a "sign in as" picker for allowed emails
# instead of the OIDC provider. Ignored when NODE_ENV=production.
ALMANAC_DEV_LOGIN=1

# Smart add: quick add sends what's typed to Claude Haiku, which turns it into tasks and list items
# to review. Optional; without a key, quick add adds things as typed. In Docker, put the key in
# secrets/anthropic_api_key instead (ANTHROPIC_API_KEY_FILE points at it).
ANTHROPIC_API_KEY=
# ALMANAC_AI_EFFORT=medium        # low, medium or high
# ALMANAC_AI_MONTHLY_CAP_USD=10   # AI features pause for the rest of the month past this
