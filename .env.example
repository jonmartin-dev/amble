# Copy to .env for local development. Every variable is optional unless noted.

# Where the app is reachable from browsers, without a trailing slash.
# Required in production; used for OAuth redirect URLs and secure cookies.
# A path is allowed for running under a prefix, e.g. https://example.com/amble
AMBLE_PUBLIC_URL=http://localhost:5173
# After moving the app to another path, the old one can send people and links on to the new one:
# AMBLE_REDIRECT_FROM=/old-path
# (Settings named ALMANAC_*, from before the app was renamed Amble, still work.)

PORT=8787
AMBLE_DATA_DIR=./data
AMBLE_TIMEZONE=America/Chicago

# Who may sign in. Comma-separated emails. Admins are always allowed.
AMBLE_ADMIN_EMAILS=
AMBLE_ALLOWED_EMAILS=

# Who to ask about privacy, shown on the public /privacy page (Google's consent screen asks for
# a privacy policy link). Optional.
# AMBLE_PRIVACY_CONTACT=you@example.com

# OpenID Connect provider. Google is the default; any OIDC provider works
# (Authentik, Authelia, Keycloak, ...). Redirect URI to register:
#   <AMBLE_PUBLIC_URL>/auth/callback
# docs/sign-in.md has the steps for each provider.
OIDC_ISSUER=https://accounts.google.com
OIDC_PROVIDER_NAME=Google
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Google Calendar, so busy days have less room for tasks. With Google sign-in above, the same
# client is used and nothing needs setting here; just enable the Google Calendar API in its Cloud
# project. With another sign-in provider, give a Google OAuth client of its own (web application,
# redirect URI <AMBLE_PUBLIC_URL>/auth/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Syncing through Google Drive. The server uses the Google client above (or GOOGLE_CLIENT_ID) and
# needs the Google Drive API turned on in its Cloud project; an admin connects it in Settings, Sync.
# The device app (pnpm dev:device, pnpm build:device) signs in to Google in the browser and needs
# these, which end up in the app's code; docs/google-drive.md has the setup.
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_API_KEY=            # a key restricted to the Google Picker API and the app's address
# VITE_GOOGLE_APP_ID=             # the Cloud project number

# Files on tasks are kept under <AMBLE_DATA_DIR>/files, each up to this many megabytes.
# AMBLE_MAX_FILE_MB=25

# Reminders use web push. The keys are made on first start and kept in the database; nothing to set.

# Assistants that may connect to the connector: Claude and ChatGPT (hosts of their
# client metadata URLs and web redirect URIs). Loopback apps such as Claude Code always can.
AMBLE_OAUTH_CLIENT_HOSTS=claude.ai,claude.com,chatgpt.com

# Local development only: show a "sign in as" picker for allowed emails
# instead of the OIDC provider. Ignored when NODE_ENV=production.
AMBLE_DEV_LOGIN=1

# AI: smart add, size guesses, the morning's suggestions, Plan my week and Tidy up all use one fast
# model, from any provider. Optional: without one, quick add adds things as typed and the planner
# words things itself. The admin can also set it up in the app (Settings, AI), which wins over these.
# Providers: anthropic (Claude Haiku 5.5), openai (GPT-6 Luna), gemini (Gemini Flash-Lite, free tier),
# zai (GLM Flash, free), openrouter (any model, one key), or custom (any OpenAI-style API, such as
# Ollama at http://localhost:11434/v1, which needs no key).
# In Docker, put the key in secrets/ai_api_key instead (AMBLE_AI_API_KEY_FILE points at it).
# AMBLE_AI_PROVIDER=anthropic
# AMBLE_AI_API_KEY=
# AMBLE_AI_MODEL=               # empty for the provider's suggested model
# AMBLE_AI_BASE_URL=            # custom only: the API's address
# AMBLE_AI_EFFORT=              # default, low, medium or high; empty for the model's suggested one
# AMBLE_AI_MONTHLY_CAP_USD=10   # AI features pause for the rest of the month past this
# AMBLE_AI_PRICES=0.1,0.5       # dollars per million tokens in and out, for a model Amble doesn't know
# Older setups: an Anthropic key on its own still works, as ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
